# Copie este arquivo para .env e preencha com seus valores.

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# API LegisWeb (https://www.legisweb.com.br) - credenciais da sua conta contratada
LEGISWEB_USER_ID=seu-codigo-de-usuario
LEGISWEB_TOKEN=seu-token-da-api

# Banco de dados (opcional). Sem POSTGRES_DB o sistema usa SQLite (db.sqlite3).
# POSTGRES_DB=analise_tributaria
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=sua-senha
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
